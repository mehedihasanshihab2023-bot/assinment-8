{
  "name": "studiospace-server",
  "version": "1.0.0",
  "private": true,
  "description": "StudioSpace API – peer-to-peer creative workspace and production studio booking backend (Express + MongoDB).",
  "main": "api/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test:api": "node scripts/smoke-test.js",
    "deploy": "vercel --prod",
    "test": "echo \"Run npm start in one terminal, then npm run test:api in another.\" && exit 0"
  },
  "keywords": [
    "studiospace",
    "express",
    "mongodb",
    "jwt",
    "bookings",
    "marketplace"
  ],
  "author": "StudioSpace",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.0"
  }
}
