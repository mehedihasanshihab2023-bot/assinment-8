# StudioSpace API – environment variables
# Copy this file to .env and fill in the values.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/

# Logical database name inside the cluster
DB_NAME=studiospace

# Public http(s) origin of the Next.js client, comma separated for multiple origins
CLIENT_URLS=http://localhost:3000,https://your-client.vercel.app

# JWT signing secret (use `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: required only if you use /api/auth/google on the server
# (Google Identity Services verifies the ID token's audience against this value)
GOOGLE_CLIENT_ID=

# Optional: enables POST /api/meta/upload (imgbb image hosting proxy)
IMGBB_API_KEY=

# production on Vercel, development locally
NODE_ENV=development
